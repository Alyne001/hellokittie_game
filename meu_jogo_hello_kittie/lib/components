import 'package:flame/components.dart';
import 'package:flame/game.dart';

class HelloKitty extends SpriteComponent with HasGameRef<KittyGame> {
  HelloKitty() : super(size: Vector2.all(64)); // tamanho do personagem

  @override
  Future<void> onLoad() async {
    super.onLoad();
    sprite = await gameRef.loadSprite('hello_kitty.png'); // imagem na pasta assets/images
    position = Vector2(100, 100); // posição inicial na tela
  }
}